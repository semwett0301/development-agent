# Kafka (KRaft mode, no Zookeeper)
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT_INTERNAL://0.0.0.0:29092,PLAINTEXT_EXTERNAL://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT_INTERNAL://kafka:29092,PLAINTEXT_EXTERNAL://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT_INTERNAL:PLAINTEXT,PLAINTEXT_EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT_INTERNAL

# Replication factor 1 — single broker setup
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1


# Docker Hub (prod only)
DOCKERHUB_USERNAME=your_dockerhub_username

# Webhook service
GITHUB_WEBHOOK_SECRET=your_webhook_secret
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Coding agent - LLM Configuration
# Provider: anthropic, openai, mistral, yandex
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-5-20251101
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=0.1

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI (GPT-4o, GPT-4o-mini, etc.)
# OPENAI_API_KEY=your_openai_api_key
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# Mistral AI
# MISTRAL_API_KEY=your_mistral_api_key
# LLM_PROVIDER=mistral
# LLM_MODEL=mistral-large-latest

# Yandex GPT
# YANDEX_API_KEY=your_yandex_api_key
# YANDEX_FOLDER_ID=your_folder_id
# LLM_PROVIDER=yandex
# LLM_MODEL=yandexgpt

# Langfuse (observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# GitHub App (for coding-agent)
GITHUB_APP_ID=your_app_id

# Private key must be base64 encoded: cat private-key.pem | base64 | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=

# GitHub Token (for reviewer-agent)
GITHUB_TOKEN=